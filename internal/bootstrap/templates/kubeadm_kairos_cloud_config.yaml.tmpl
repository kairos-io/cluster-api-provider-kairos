#cloud-config
{{- /*
Template inputs (from Go), for a provider-kubernetes worker:

  .Hostname          string          // explicit hostname (optional)
  .HostnamePrefix    string          // e.g. "metal-", used when Hostname is empty
  .UserName          string          // e.g. "kairos"
  .UserPassword      string          // e.g. "kairos" (optional)
  .UserGroups        []string        // e.g. ["admin"]
  .GitHubUser        string          // optional
  .SSHPublicKey      string          // alternative to GitHubUser (optional)
  .DNSServers        []string        // optional DNS resolvers
  .Install           *InstallConfig  // install configuration (optional)
  .KubeadmCluster    *KubeadmCluster // provider-kubernetes cluster block (required)
*/ -}}

{{/* The {{ trunc 4 .MachineID }} is Kairos templating syntax, output literally */}}
{{- if .Hostname }}
hostname: {{ .Hostname | quote }}
{{- else if .HostnamePrefix }}
hostname: {{ printf "%s{{ trunc 4 .MachineID }}" .HostnamePrefix | quote }}
{{- end }}

{{- if .Install }}
install:
  auto: {{ .Install.Auto }}
  device: {{ .Install.Device | quote }}
  reboot: {{ .Install.Reboot }}
{{- end }}

users:
  - name: {{ .UserName | quote }}
    {{- if .UserPassword }}
    passwd: {{ .UserPassword | quote }}
    {{- end }}
    groups:
    {{- range .UserGroups }}
      - {{ . | quote }}
    {{- end }}
    {{- if or .GitHubUser .SSHPublicKey }}
    ssh_authorized_keys:
    {{- if .GitHubUser }}
      - {{ printf "github:%s" .GitHubUser | quote }}
    {{- end }}
    {{- if .SSHPublicKey }}
      - {{ .SSHPublicKey | quote }}
    {{- end }}
    {{- end }}

stages:
  initramfs:
    - name: pre-kubeadm
      sysctl:
        net.ipv4.ip_forward: "1"
        kernel.panic: "10"
        kernel.panic_on_oops: "1"
        vm.overcommit_memory: "1"
{{- if .DNSServers }}
  boot:
    - name: "Configure DNS resolvers for early boot"
      dns:
        nameservers:
        {{- range .DNSServers }}
          - {{ . | quote }}
        {{- end }}
        path: "/etc/resolv.conf"
{{- end }}

cluster:{{ toYaml .KubeadmCluster | nindent 2 }}
